# Base, non-secret defaults (overridden per environment in overlays/<env>/app.env).
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Heap ~62% of the 512Mi limit: the rest is off-heap (WS/audio Buffers, TLS,
# Prisma query engine). V8 must GC before the kernel OOM killer acts.
NODE_OPTIONS=--max-old-space-size=320
